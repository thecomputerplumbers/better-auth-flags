{
  "name": "better-auth-flags-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" test",
    "test:pg": "pnpm --filter \"./packages/*\" test:pg"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  }
}
