{
  "name": "@thecomputerplumbers/better-auth-flags",
  "version": "0.0.0",
  "description": "Feature flags for better-auth: database-backed boolean and multivariate flags with overrides, targeting rules, and percentage rollouts.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "feature-flags",
    "feature-toggles",
    "rollout"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0",
    "nanostores": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-auth": "^1.7.10",
    "nanostores": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecomputerplumbers/better-auth-flags.git",
    "directory": "packages/better-auth-flags"
  }
}
